+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+
+import time
+import torch
+from fastsafetensors import fastsafe_open, SafeTensorsFileLoader
+from fastsafetensors.st_types import Device
+
+
+# Test function to measure loading time
+def test_loading_time(loader_name, filenames, device="cuda:0", nogds=False):
+    print(f"Testing {loader_name}...")
+    start_time = time.time()
+
+    with fastsafe_open(filenames=filenames, device=device, nogds=nogds) as f:
+        keys = f.keys()
+        print(f"Found {len(keys)} tensors")
+
+        # Load all tensors
+        tensors = {}
+        for key in keys:
+            tensor = f.get_tensor(key)
+            tensors[key] = tensor
+
+    end_time = time.time()
+    loading_time = end_time - start_time
+    print(f"{loader_name} loading time: {loading_time:.4f} seconds")
+    return loading_time
+
+
+# Test with different copier types
+def test_copier_types(filenames, device="cuda:0"):
+    print("Testing different copier types...")
+    print("=" * 60)
+
+    # nogds_time = test_loading_time("NoGDS", filenames, device, nogds=True)
+    # print("=" * 60)
+
+    nogds = False
+    use_fgds = os.environ.get('USE_FGDS', '').lower() in ('true', '1', 'yes')
+    if use_fgds:
+        copier = "FGDS"
+        nogds = True
+    else:
+        copier = "GDS"
+
+    take_time = test_loading_time(copier, filenames, device, nogds=nogds)
+    print("-" * 60)
+
+    # Compare results
+    print("Performance comparison:")
+    print(f"{copier}: {take_time:.4f} seconds")
+
+
+if __name__ == "__main__":
+    # Use the example files provided in the repository
+    import os
+
+    # example_dir = os.path.dirname(os.path.abspath(__file__))
+    # filenames = [os.path.join(example_dir, "a.safetensors"), os.path.join(example_dir, "b.safetensors")]
+
+    # example_dir = ["/data3/Qwen-0.6B", "/data3/Qwen3-8B", "/data3/Qwen-32B"]
+    example_dir = ["/data3/Qwen-32B"]
+    # example_dir = ["/data3/Qwen3-8B"]
+    # example_dir = ["/data3/Qwen-0.6B"]
+    for edir in example_dir:
+        time.sleep(2)
+        os.system("sync && echo 3 > /proc/sys/vm/drop_caches")
+
+        items = os.listdir(edir)
+        filenames = []
+        for item in items:
+            if item.endswith(".safetensors"):
+                filenames.append(item)
+        filenames = [os.path.join(edir, f) for f in sorted(filenames)]
+        # Check if files exist
+        for filename in filenames:
+            if not os.path.exists(filename):
+                print(f"File not found: {filename}")
+                print("Please run gen.py to generate test files first.")
+                exit(1)
+
+        # Test with GPU if available
+        if torch.cuda.is_available():
+            print("Testing on GPU...")
+            test_copier_types(filenames, device="cuda:0")
+        else:
+            print("GPU not available, skipping GPU test.")
