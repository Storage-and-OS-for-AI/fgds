--- /dev/null
+++ b/fastsafetensors/copier/fgds.py
@@ -0,0 +1,229 @@
+# SPDX-License-Identifier: Apache-2.0
+import time
+import warnings
+import ctypes
+import os
+import tempfile
+import torch
+from typing import Dict, Optional, List
+
+from ..common import SafeTensorsMetadata, init_logger, is_gpu_found
+from ..frameworks import FrameworkOpBase, TensorBase
+from ..st_types import Device, DeviceType, DType
+from .base import CopierInterface
+from .nogds import load_library_func, new_nogds_file_copier
+from .registry import CopierConstructFunc, register_copier_constructor
+
+# Import C++ FGDS extension
+from .. import fgds_ext as fstcpp
+
+logger = init_logger(__name__)
+
+
+class FgdsFileCopier(CopierInterface):
+    def __init__(
+        self,
+        metadata: SafeTensorsMetadata,
+        device: Device,
+        reader: fstcpp.fgds_file_reader,
+        framework: FrameworkOpBase,
+        max_threads: int = 16,
+    ):
+        self.framework = framework
+        self.metadata = metadata
+        self.device = device
+        device_list = os.environ.get("CUDA_VISIBLE_DEVICES", "0")
+        idx = device.index if device.index is not None else 0
+        self.device_id = int(device_list.split(",")[idx])
+        self.fgds = None
+        self.copy_reqs: Dict[int, int] = {}
+        self.aligned_length = 0
+        self.aligned_offset = 0
+        self.max_threads = max_threads
+        self.o_direct = True
+
+        # For C++ implementation
+        self.fgds_handle = None
+        self.fgds_reader = reader
+        # For Python fallback
+        result = fstcpp.fgds_open(self.device_id)
+        if result != 0:
+            warnings.warn(f"fgds_open failed with error code: {result}", UserWarning)
+        
+        self.registered_memory = None
+
+    def set_o_direct(self, enable: bool):
+        self.o_direct = True
+
+    def submit_io(
+        self, use_buf_register: bool, max_copy_block_size: int
+    ) -> object:  # Return GPU buffer object
+        # Calculate alignment and offsets
+        ALIGN = 64 * 1024  # FGDS typical alignment
+        offset = self.metadata.header_length
+        length = self.metadata.size_bytes - self.metadata.header_length
+        head_bytes = offset % ALIGN
+        tail_bytes = (length + head_bytes) % ALIGN
+        if tail_bytes > 0:
+            tail_bytes = ALIGN - tail_bytes
+            aligned_length = length + head_bytes + tail_bytes
+        else:
+            aligned_length = length + head_bytes
+        aligned_offset = offset - head_bytes
+
+        # Allocate GPU memoryol
+        start = time.time()
+        gbuf = self.framework.alloc_tensor_memory(aligned_length, self.device)
+        gbuf_ptr = gbuf.get_base_address()
+        #warnings.warn(f"device is :{self.device.as_str()}, {self.device_id}", UserWarning)
+        warnings.warn(f"fgds alloc mem {gbuf_ptr} take {time.time() - start:.4f} seconds")
+        
+        # Set max_copy_block_size to 1 GB for better performance
+        #max_copy_block_size = 1 * 1024 * 1024 * 1024  # 1 GB
+        # Create FGDS file handle
+        self.fgds_handle = fstcpp.fgds_file_handle(self.metadata.src, self.o_direct, self.device_id)
+
+        # For FGDS, we need to register GPU memory
+        result = fstcpp.fgds_regmem(self.device_id, gbuf_ptr, aligned_length, None)
+        if result != 0:
+            warnings.warn(f"fgds_regmem failed with error code: {result}", UserWarning)
+            self.registered_memory = None
+        else:
+            self.registered_memory = (self.device_id, gbuf_ptr, aligned_length)
+        #warnings.warn(f"fgds regmem gpu buf: {gbuf_ptr}, aligned length: {aligned_length}, device: {device_id}", UserWarning)
+        warnings.warn(f"fgds alloc mem and cufile register take {time.time() - start:.4f} seconds")
+        # Submit read requests asynchronously
+        self.copy_reqs = {}
+        count = 0
+        while count < aligned_length:
+            req_len = aligned_length - count
+            if req_len > max_copy_block_size:
+                req_len = max_copy_block_size
+            # warnings.warn(f"fgds req_len = {req_len}, aligned len = {aligned_length}")
+            # Create device buffer
+            dev_buf = fstcpp.fgds_device_buffer(gbuf_ptr + count, req_len)
+            #warnings.warn(f"create device buffer:{gbuf_ptr + count}, len:{req_len}")
+            # Submit read request
+            req_id = self.fgds_reader.submit_read(
+                self.fgds_handle,
+                dev_buf,
+                aligned_offset + count,
+                req_len,
+                count
+            )
+
+            # Store request information
+            self.copy_reqs[req_id] = count
+            # warnings.warn(f"submit read and copy reqs, {req_id}, off:{aligned_offset + count}, len:{req_len} take {time.time()-start:.4f} seconds")
+            count += req_len
+        
+        self.aligned_offset = aligned_offset
+        self.aligned_length = aligned_length
+        self.gbuf = gbuf
+        return gbuf
+
+    def wait_io(
+        self,
+        gbuf: object,  # GPU buffer object
+        dtype: DType = DType.AUTO,
+        noalign: bool = False,
+    ) -> Dict[str, TensorBase]:
+        # Wait for all read requests to complete
+        for req_id in sorted(self.copy_reqs.keys()):
+            result = self.fgds_reader.wait_read(req_id)
+            if result < 0:
+                warnings.warn(f"fgds_read failed for request {req_id}", UserWarning)
+            # warnings.warn(f"wait read {req_id} done")
+        # Deregister memory if it was registered
+        if hasattr(self, 'registered_memory') and self.registered_memory:
+            device_id, addr, size = self.registered_memory
+            #warnings.warn(f"start deregmem {addr}, size:{size}")
+            result = fstcpp.fgds_deregmem(device_id, addr, size)
+            # result = self.fgds_handle.get_wrapper().deregmem(device_id, addr, size)
+            if result != 0:
+                warnings.warn(f"fgds_deregmem failed with error code: {result}", UserWarning)
+            self.registered_memory = None
+            #warnings.warn(f"deregmem {addr}, size:{size} done")
+
+        # Clear copy requests
+        self.copy_reqs = []
+
+        # Get tensors from metadata
+        return self.metadata.get_tensors(
+            gbuf, self.device, self.aligned_offset, dtype=dtype
+        )
+
+    def __del__(self):
+        pass
+
+_inited_fgds = False
+
+
+def init_fgds():
+    load_library_func()
+    global _inited_fgds
+    if not _inited_fgds:
+        # FGDS initialization is handled by FgdsDriver or C++ implementation
+        _inited_fgds = True
+
+
+@register_copier_constructor("fgds")
+def new_fgds_file_copier(
+    device: Device,
+    framework: FrameworkOpBase,
+    bbuf_size_kb: int = 16 * 1024,
+    max_threads: int = 16,
+) -> CopierConstructFunc:
+    init_fgds()
+    device_is_not_cpu = device.type != DeviceType.CPU
+    if device_is_not_cpu and not is_gpu_found():
+        raise Exception(
+            "[FAIL] GPU runtime library (libcudart.so or libamdhip64.so) does not exist"
+        )
+    
+    # Check if FGDS is available
+    try:
+        # Test C++ FGDS implementation
+        device_list = os.environ.get("CUDA_VISIBLE_DEVICES", "0")
+        idx = device.index if device.index is not None else 0
+        device_id = int(device_list.split(",")[idx])
+        
+        # Create a temporary file to test FGDS availability
+        with tempfile.NamedTemporaryFile(delete=False) as tmp_file:
+            tmp_file.write(b"test")
+            tmp_filename = tmp_file.name
+        
+        try:
+            # Create a temporary handle to test FGDS availability
+            # Use o_direct=False for better compatibility
+            tmp_handle = fstcpp.fgds_file_handle(tmp_filename, True, device_id)
+            del tmp_handle
+        finally:
+            # Clean up temporary file
+            if os.path.exists(tmp_filename):
+                os.unlink(tmp_filename)
+    except Exception as e:
+        warnings.warn(
+            f"FGDS is not available: {e}. Falling back to NoGDS.",
+            UserWarning,
+        )
+        return new_nogds_file_copier(device, bbuf_size_kb, max_threads)
+    
+    # Create FGDS file reader
+    reader = fstcpp.fgds_file_reader(max_threads, device_id)
+    
+    def construct_copier(
+        metadata: SafeTensorsMetadata,
+        device: Device,
+        framework: FrameworkOpBase,
+    ) -> CopierInterface:
+        return FgdsFileCopier(
+            metadata,
+            device, 
+            reader,
+            framework,
+            max_threads=max_threads
+        )
+
+    warnings.warn(f"use fgds copier max_threads:{max_threads}")
+    return construct_copier
