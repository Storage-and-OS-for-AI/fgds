%define debug_package %{nil}
%define __brp_python_bytecompile true // skip python bytecompile
%define __name fgds
%define __version @VERSION@
%define __release @RELEASE@
%define __prefix /opt
%define __install_dir %{__prefix}/%{__name}
%define __install_local_bin_dir /usr/local/bin
%define __install_bin_dir %{__install_dir}

Name:           %{__name}
Summary:        The fast GPU Direct Storage filesystem
Version:        %{__version}
Release:        %{__release}
License:        Apache2.0 
Group:          System Environment/Base
Vendor:         KylinSoft
URL:            https://github.com/nicexlab/phoenix
Source0:        %{name}-%{version}.tar.gz
BuildRoot:      %{_tmppath}/%{name}-%{version}-root
BuildRequires:  cmake >= 3.18, gcc >= 11.4.0, g++ >= 11.4.0
BuildRequires:  kernel-devel, kernel-core, liburing-devel, libaio-devel, util-linux, kmod
BuildRequires:  make, rpm-build, chrpath, cuda-toolkit, nvidia-driver-cuda, kmod-nvidia-open-dkms
ExcludeArch:    loongarch64

%description
The FGDS is a refactored I/O Stack for GPU Direct Storage without Phony Buffers.
This package provide the fgds kernel module and dynamic library for user space.

%prep
%setup -q -n %{name}-%{version}

%build
export CUDA_HOME="/usr/local/cuda"
export PATH=$PATH:$CUDA_HOME/bin

mkdir build && cd build && cmake .. -Dno_module=ON && make && cd ..

%install
[ -e %{buildroot} ] && rm -rf %{buildroot}
mkdir -p $RPM_BUILD_ROOT/%{__install_dir}
mkdir -p $RPM_BUILD_ROOT/%{__install_dir}/bin
mkdir -p $RPM_BUILD_ROOT/%{__install_dir}/docs
mkdir -p $RPM_BUILD_ROOT/usr/lib64

cp -aprv build/bin $RPM_BUILD_ROOT/%{__install_dir}/
cp -aprv python $RPM_BUILD_ROOT/%{__install_dir}/
cp -aprv module $RPM_BUILD_ROOT/%{__install_dir}/
cp -aprv scripts $RPM_BUILD_ROOT/%{__install_dir}/
cp -apv build/libfgds.so $RPM_BUILD_ROOT/usr/lib64/libfgds.so
cp -apv build/module/Makefile $RPM_BUILD_ROOT/%{__install_dir}/module/Makefile
cp -apv config.json $RPM_BUILD_ROOT/%{__install_dir}/config.json
cp -apv README.md $RPM_BUILD_ROOT/%{__install_dir}/docs/README.md
cp -apv README_CN.md $RPM_BUILD_ROOT/%{__install_dir}/docs/README_CN.md
rm -f $RPM_BUILD_ROOT/%{__install_dir}/module/.gitignore


%post
if [ $1 -eq 1 ]; then
    echo "Please make sure the cuda toolkit and cuda driver is ready before using the fgds"
    echo "Check the docs/README_CN.md for more details."
fi

%files
%defattr(-,root,root)
%dir %{__install_dir}
%dir %{__install_dir}/python
%dir %{__install_dir}/python/fgds
%dir %{__install_dir}/python/fgds_backend
